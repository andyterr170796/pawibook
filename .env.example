# Copia este archivo como ".env" y completa lo que necesites.
# El .env tiene secretos: está en .gitignore y nunca debe subirse a GitHub.

# --- Asistente Pawi (OpenAI) ---
OPENAI_API_KEY=
PAWBOOK_MODELO=gpt-6.1-terra
# Topes de mensajes con Pawi por cuenta (cada mensaje cuesta una llamada a OpenAI)
# PAWBOOK_LIMITE_PAWI_MINUTO=10
# PAWBOOK_LIMITE_PAWI_DIA=100

# --- Correos con Resend (recuperar contraseña, bienvenida, avisos de seguridad) ---
# Clave de https://resend.com/api-keys
RESEND_API_KEY=
# Remitente con un dominio verificado en Resend (Domains). Vacío = onboarding@resend.dev, que solo
# sirve para pruebas: Resend únicamente entrega al correo dueño de la cuenta de Resend.
RESEND_FROM=Pawbook <notificaciones@tu-dominio.com>
# A dónde llegan las respuestas a los correos (opcional)
# RESEND_REPLY_TO=soporte@tu-dominio.com

# --- Servidor ---
PAWBOOK_PUERTO=8001
# Usa 0.0.0.0 para abrirlo a otros equipos de tu red local
# PAWBOOK_HOST=127.0.0.1
# Dirección pública para los enlaces de los correos. Con ngrok se toma sola; defínela si usas un dominio propio.
# PAWBOOK_URL_PUBLICA=https://tu-dominio.com
# Otros orígenes desde los que se aceptan formularios (separados por comas). Normalmente no hace falta.
# PAWBOOK_ORIGENES=
# Tamaño máximo de un envío (fotos incluidas), en MB
# PAWBOOK_MAX_SUBIDA_MB=25
# Intentos de inicio de sesión por minuto (por IP y por correo)
# PAWBOOK_LIMITE_LOGIN=5

# --- Clave de las cookies de sesión ---
# Si la dejas vacía, Pawbook genera una aleatoria y la guarda en .secret_key (recomendado).
# Si la defines, usa al menos 32 caracteres aleatorios.
# PAWBOOK_SECRET_KEY=

# --- ngrok (opcional) ---
# Si ya configuraste ngrok en este equipo (como en la web UFI) no hace falta el token.
# NGROK_AUTHTOKEN=
# Dominio fijo de tu cuenta ngrok (si lo dejas vacío, ngrok genera un enlace nuevo cada vez).
# Ojo: si usas el mismo dominio que la web UFI, no podrán estar publicadas a la vez.
# NGROK_DOMAIN=tu-dominio.ngrok-free.dev

# --- Administrador (se crea al primer inicio) ---
# Usa un correo real para poder recuperar la contraseña del administrador por correo.
# PAWBOOK_ADMIN_EMAIL=admin@pawbook.local
# PAWBOOK_ADMIN_PASSWORD=

# --- Datos de demostración (1 = cargar si la base está vacía, 0 = no) ---
# Para un Pawbook abierto al público usa 0: la cuenta demo es compartida por todos los visitantes.
PAWBOOK_DEMO=1
